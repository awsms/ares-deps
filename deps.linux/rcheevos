rcheevos_name='rcheevos'
rcheevos_version='12.3.0'
rcheevos_url='https://github.com/RetroAchievements/rcheevos.git'
rcheevos_hash='e9ca3694c862b61235595176dac4b22677848c93'

rcheevos_setup() {
  echo "[rcheevos] cloning"
  if [ ! -d "rcheevos" ]; then
    git clone https://github.com/RetroAchievements/rcheevos.git
  else
    git -C rcheevos fetch
  fi
  git -C rcheevos reset --hard "$rcheevos_hash"
  echo "[rcheevos] cloning -- success"
}

rcheevos_package_source() {
  echo "[rcheevos] packaging source"
  mkdir -p ../ares-deps-source/src/rcheevos
  cp -R rcheevos/. ../ares-deps-source/src/rcheevos
  echo "[rcheevos] packaging source -- success"
}

rcheevos_clean() {
  echo "[rcheevos] cleaning up -- skipped"
}

rcheevos_patch() {
  echo "[rcheevos] patching source"
  mkdir -p rcheevos/cmake
  cat > rcheevos/CMakeLists.txt <<'EOF'
cmake_minimum_required(VERSION 3.28)
project(rcheevos VERSION 12.3.0 LANGUAGES C)

include(CMakePackageConfigHelpers)

add_library(
  rcheevos
  STATIC
  src/rapi/rc_api_common.c
  src/rapi/rc_api_info.c
  src/rapi/rc_api_runtime.c
  src/rapi/rc_api_user.c
  src/rc_client.c
  src/rc_compat.c
  src/rc_util.c
  src/rc_version.c
  src/rcheevos/alloc.c
  src/rcheevos/condition.c
  src/rcheevos/condset.c
  src/rcheevos/consoleinfo.c
  src/rcheevos/format.c
  src/rcheevos/lboard.c
  src/rcheevos/memref.c
  src/rcheevos/operand.c
  src/rcheevos/rc_validate.c
  src/rcheevos/richpresence.c
  src/rcheevos/runtime.c
  src/rcheevos/runtime_progress.c
  src/rcheevos/trigger.c
  src/rcheevos/value.c
  src/rhash/hash.c
  src/rhash/hash_rom.c
  src/rhash/md5.c
)

target_include_directories(
  rcheevos
  PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
    $<INSTALL_INTERFACE:include/rcheevos>
  PRIVATE src
)

target_compile_definitions(
  rcheevos
  PUBLIC
    RC_CLIENT_SUPPORTS_HASH
    RC_HASH_NO_DISC
    RC_HASH_NO_ZIP
    RC_HASH_NO_ENCRYPTED
    RC_STATIC
)

install(
  TARGETS rcheevos
  EXPORT rcheevosTargets
  ARCHIVE DESTINATION lib
  LIBRARY DESTINATION lib
  RUNTIME DESTINATION bin
)

install(DIRECTORY include/ DESTINATION include/rcheevos)

install(
  EXPORT rcheevosTargets
  NAMESPACE rcheevos::
  FILE rcheevosTargets.cmake
  DESTINATION lib/cmake/rcheevos
)

configure_package_config_file(
  cmake/rcheevosConfig.cmake.in
  ${CMAKE_CURRENT_BINARY_DIR}/rcheevosConfig.cmake
  INSTALL_DESTINATION lib/cmake/rcheevos
)

write_basic_package_version_file(
  ${CMAKE_CURRENT_BINARY_DIR}/rcheevosConfigVersion.cmake
  VERSION ${PROJECT_VERSION}
  COMPATIBILITY SameMajorVersion
)

install(
  FILES
    ${CMAKE_CURRENT_BINARY_DIR}/rcheevosConfig.cmake
    ${CMAKE_CURRENT_BINARY_DIR}/rcheevosConfigVersion.cmake
  DESTINATION lib/cmake/rcheevos
)
EOF
  cat > rcheevos/cmake/rcheevosConfig.cmake.in <<'EOF'
@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/rcheevosTargets.cmake")
EOF
  echo "[rcheevos] patching source -- success"
}

rcheevos_build() {
  echo "[rcheevos] building"
  cmake -S rcheevos -B rcheevos-build \
    -DCMAKE_BUILD_TYPE="$config" \
    -DCMAKE_INSTALL_PREFIX="$(pwd)/../ares-deps"
  cmake --build rcheevos-build --config "$config"
  echo "[rcheevos] building -- success"
}

rcheevos_install() {
  echo "[rcheevos] installing"
  cmake --install build_temp/rcheevos-build --config "$config"
  mkdir -p ares-deps/licenses/rcheevos
  cp -R build_temp/rcheevos/LICENSE ares-deps/licenses/rcheevos/LICENSE
  echo "[rcheevos] installing -- success"
}
